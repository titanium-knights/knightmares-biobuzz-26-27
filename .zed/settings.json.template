{
  "lsp": {
    "jdtls": {
      "initialization_options": {
        "bundles": [],
        // This file is a template. .zed/setup.sh copies it to .zed/settings.json (git-ignored)
        // with __REPO_DIR__ replaced by this clone's absolute path.
        //
        // workspaceFolders must point at this repo. Without it jdtls falls back to whatever the
        // user's global Zed settings say, if anything, and this repo is never imported (every
        // file shows up as "a non-project file").
        "workspaceFolders": [
          "file://__REPO_DIR__",
        ],
        // Keep jdtls's Gradle/Maven import DISABLED. For Android modules, Buildship (jdtls's
        // Gradle importer) finds no sources or dependencies and OVERWRITES the .project and
        // .classpath files generated by .zed/setup.sh with empty ones. With the import off,
        // jdtls's Eclipse importer reads our generated files as-is. See .zed/README.md.
        "settings": {
          "java": {
            "import": {
              "gradle": { "enabled": false },
              "maven": { "enabled": false },
            },
          },
        },
      },
    },
  },
}
